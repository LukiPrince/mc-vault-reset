# Inline dialog instead of a registry entry: only this way can the current value
# and the slider start value be inserted - registry dialogs are static.
# $(ph) carries the text "$(secs)" and so is preserved for the dialog.
$dialog show @s {type:"minecraft:multi_action",title:{text:"Vault Reset",color:"dark_purple",bold:true},can_close_with_escape:true,pause:false,after_action:"close",body:[{type:"minecraft:plain_message",width:300,contents:[{text:"This setting applies to the whole server.\nEvery player has their own cooldown per vault.\n\n",color:"gray"},{text:"Current: ",color:"gray"},{text:"$(val) $(unit)",color:"dark_green",bold:true},{text:"\nVaults on cooldown: $(n)",color:"dark_gray"}]}],inputs:[{type:"minecraft:number_range",key:"secs",label:{text:"Custom cooldown"},label_format:"%s: %s s",start:5,end:7200,step:5,initial:$(init),width:300}],columns:3,actions:[{label:{text:"5 min"},width:98,action:{type:"minecraft:run_command",command:"/function vaultreset:config/set {seconds:300}"}},{label:{text:"15 min"},width:98,action:{type:"minecraft:run_command",command:"/function vaultreset:config/set {seconds:900}"}},{label:{text:"30 min"},width:98,action:{type:"minecraft:run_command",command:"/function vaultreset:config/set {seconds:1800}"}},{label:{text:"1 h"},width:98,action:{type:"minecraft:run_command",command:"/function vaultreset:config/set {seconds:3600}"}},{label:{text:"6 h"},width:98,action:{type:"minecraft:run_command",command:"/function vaultreset:config/set {seconds:21600}"}},{label:{text:"24 h"},width:98,action:{type:"minecraft:run_command",command:"/function vaultreset:config/set {seconds:86400}"}}],exit_action:{label:{text:"Apply slider value"},width:300,action:{type:"minecraft:dynamic/run_command",template:"/function vaultreset:config/set {seconds:$(ph)}"}}}
